{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Network-Weather/mt7921u-macos/blob/main/docs/hardware-smoke.schema.json",
  "title": "mt7921u-macos passive hardware smoke result",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_utc",
    "status",
    "software",
    "host",
    "plan",
    "firmware",
    "device",
    "bands",
    "totals",
    "duration_seconds"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail", "inconclusive", "unsupported"] },
    "software": { "type": "object" },
    "host": { "type": "object" },
    "plan": {
      "type": "object",
      "required": ["name", "dwell_seconds", "channels", "requested_bands"]
    },
    "firmware": { "type": "object" },
    "device": { "type": ["object", "null"] },
    "bands": { "type": "object" },
    "totals": { "type": "object" },
    "error": { "type": "object" },
    "duration_seconds": { "type": "number", "minimum": 0 }
  },
  "additionalProperties": false
}
